MYSQL_ROOT_PASSWORD=replace_with_local_password
MYSQL_DATABASE=analyzedb_demo
MYSQL_PORT=3306

# read-only account user
MYSQL_HOST=127.0.0.1
MYSQL_USER=analyzedb_reader
MYSQL_PASSWORD=YourNewReaderPassword

# Supabase PostgreSQL
PGHOST=YOUR_SUPABASE_POOLER_HOST
PGPORT=5432
PGUSER=YOUR_SUPABASE_POOLER_USERNAME
PGPASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
PGDATABASE=postgres
PGSSLMODE=require