MYSQL_ROOT_PASSWORD=replace_with_local_password
MYSQL_DATABASE=analyzedb_demo
MYSQL_PORT=3306

# read-only account user
MYSQL_HOST=127.0.0.1
MYSQL_USER=analyzedb_reader
MYSQL_PASSWORD=YourNewReaderPassword

# Column statistics discovery stays metadata-only by default. Setting this to
# true issues up to the configured number of COUNT-based null-count queries.
SCHEMA_STATISTICS_INCLUDE_EXACT_NULL_COUNTS=false
SCHEMA_STATISTICS_MAX_EXACT_NULL_COUNT_COLUMNS=0
# Limits persisted bucket values per column; 0 keeps histogram metadata only.
SCHEMA_STATISTICS_MAX_HISTOGRAM_BUCKETS=100

# Supabase PostgreSQL
PGHOST=YOUR_SUPABASE_POOLER_HOST
PGPORT=5432
PGUSER=YOUR_SUPABASE_POOLER_USERNAME
PGPASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
PGDATABASE=postgres
PGSSLMODE=require
